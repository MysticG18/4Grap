int Busqueda (Tproductos vector[],int Dim,float Abuscar,Campos Motivo){
float busqueda1;
int ubi;
int b=0;
for(int i=0;i<Dim && b==0;i++){
    switch(Motivo){
        case Codigo: busqueda1=vector[i].cod;break;
        case Cantidad: busqueda1=vector[i].cant;break;
        case Importe: busqueda1=vector[i].imp;break;
    }
    if(Abuscar==busqueda1){
        ubi=i;
        b=1;
    }
}
if(b==0){
    ubi=-1;
}
return ubi; 

}


void Ordenamieto (Tproductos vector[],int Dim,Tproductos Aux,Campos Motivo){
float num1;
float num2;
int k=Dim-1;
int b=0;
do{
b=0;

for(int i=0;i<k;i++){
    switch(Motivo){
        case Codigo: num1=vector[i].cod; num2=vector[i+1].cod; break;
        case Cantidad:num1=vector[i].cant;num2=vector[i+1].cant;break;
        case Importe: num1=vector[i].imp;num2=vector[i+1].imp;break;
    }
    if(num1>num2){
     Aux=vector[i];
     vector[i]=vector[i+1];
     vector[i+1]=Aux;
     b=1;
    }
}
k=k-1;
}while(b==1);

}
