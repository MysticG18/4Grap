        case REG_USUARIO_EXISTE:   return "Ese usuario ya existe.";
        case REG_PASSWORD_VACIA:   return "La contrasena no puede estar vacia.";
        case REG_PASSWORD_LARGA:   return "La contrasena debe tener hasta 10 caracteres.";
        case REG_LIMITE_JUGADORES: return "Se alcanzo el limite de jugadores registrados.";
