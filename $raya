    DibujarCampoTexto(&campoPassword, "Contrasena");

    Rectangle btnEntrar = { ANCHO_VENTANA / 2 - 150, 365, 300, 50 };
    Rectangle btnVolver = { ANCHO_VENTANA / 2 - 150, 430, 300, 45 };

    bool enviar = Boton(btnEntrar, "Iniciar sesion") || IsKeyPressed(KEY_ENTER);

    if (enviar) {

        int idx;
        ResultadoLogin resultado = ValidarLogin(campoUsuario.texto, campoPassword.texto,
                                                jugadores, cantJugadores, &idx);

        if (resultado != LOGIN_OK) {
            MostrarMensaje(MensajeLogin(resultado), true);
        } else if (numeroJugador == 2 && idx == ubicacion[0]) {
            MostrarMensaje("Ese jugador ya esta jugando esta partida (Jugador 1).", true);
        } else {

            ubicacion[numeroJugador - 1] = idx;
            mensaje[0] = '\0';
            ResetCampo(&campoUsuario);
            ResetCampo(&campoPassword);
            campoUsuario.activo = true;

            if (numeroJugador == 1) {
                pantalla = PANTALLA_LOGIN_J2;
            } else {
                IniciarPartida();
            }
        }
    }

    if (Boton(btnVolver, "Volver al menu")) {
        IrAMenu();
    }

    DibujarMensaje(ANCHO_VENTANA / 2 - 150, 500);
}

/* ---------------------------------------------------------------------------
 * Pantalla: Tablero de juego
 * ------------------------------------------------------------------------- */

static int FilaDisponible(int columna) {
    for (int i = FILAS - 1; i >= 0; i--) {
        if (tablero[i][columna] == 0) return i;
    }
    return -1;
}

static void FinalizarPartida(int resultado) {

    ganador = resultado;

    /* Correccion respecto al original: aca SI se suma Victory en una
     * victoria real (antes solo se sumaba si alguien abandonaba) y el
     * Streak se le asigna al jugador que efectivamente gano, no al otro. */
    if (ganador == 1) {
        jugadores[ubicacion[0]].Victory++;
        jugadores[ubicacion[0]].Streak++;
        jugadores[ubicacion[1]].Streak = 0;
    } else if (ganador == 2) {
        jugadores[ubicacion[1]].Victory++;
        jugadores[ubicacion[1]].Streak++;
        jugadores[ubicacion[0]].Streak = 0;
    } else {
        jugadores[ubicacion[0]].Streak = 0;
        jugadores[ubicacion[1]].Streak = 0;
    }

    GuardarJugadores(jugadores, cantJugadores);
    pantalla = PANTALLA_FIN;
}

static void PantallaJuego(void) {

    char turnoTexto[64];
    snprintf(turnoTexto, sizeof(turnoTexto), "Turno de: %s",
             jugadores[ubicacion[turno - 1]].Player);
    DrawText(turnoTexto, (ANCHO_VENTANA - MeasureText(turnoTexto, 26)) / 2, 40, 26,
              turno == 1 ? COLOR_J1 : (Color){ 200, 160, 20, 255 });

    DrawText("Clic en una columna, o presiona 1-7. ESC para abandonar la partida.",
              (ANCHO_VENTANA - MeasureText("Clic en una columna, o presiona 1-7. ESC para abandonar la partida.", 16)) / 2,
              90, 16, GRAY);

    /* --- Entrada del jugador --- */
    Vector2 mouse = GetMousePosition();
    int columnaElegida = -1;

    if (!animando) {

        if (mouse.x >= TABLERO_X && mouse.x < TABLERO_X + TABLERO_ANCHO &&
            mouse.y >= TABLERO_Y - TAM_CELDA && mouse.y < TABLERO_Y + TABLERO_ALTO) {

            int columnaHover = (int)((mouse.x - TABLERO_X) / TAM_CELDA);

            /* ficha "fantasma" mostrando donde caeria */
            int cx = TABLERO_X + columnaHover * TAM_CELDA + TAM_CELDA / 2;
            DrawCircle(cx, TABLERO_Y - TAM_CELDA / 2, TAM_CELDA / 2 - 10,
                       Fade(turno == 1 ? COLOR_J1 : COLOR_J2, 0.4f));

            if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
                columnaElegida = columnaHover;
            }
        }

        for (int i = 0; i < COLUMNAS; i++) {
            if (IsKeyPressed(KEY_ONE + i)) {
                columnaElegida = i;
            }
        }

        if (columnaElegida >= 0 && columnaElegida < COLUMNAS) {

            int fila = FilaDisponible(columnaElegida);

            if (fila == -1) {
                MostrarMensaje("Esa columna esta llena.", true);
            } else {
                mensaje[0] = '\0';
                columnaAnim  = columnaElegida;
                filaObjetivo = fila;
                turnoAnim    = turno;
                yFichaAnim   = (float)(TABLERO_Y - TAM_CELDA);
                animando     = true;
            }
        }

        if (IsKeyPressed(KEY_ESCAPE)) {
            FinalizarPartida(3 - turno); /* el que abandona pierde */
        }

    } else {

        float yObjetivo = (float)(TABLERO_Y + filaObjetivo * TAM_CELDA);
        yFichaAnim += VELOCIDAD_CAIDA * GetFrameTime();

        if (yFichaAnim >= yObjetivo) {

            int estadoFichas;
            int estadoVictoria;

            yFichaAnim = yObjetivo;
            animando = false;

            estadoFichas = ingresarFichas(tablero, turnoAnim, columnaAnim + 1);

            if (estadoFichas == 1) {

                if (turnoAnim == 1) {
                    mov1++;
                } else {
                    mov2++;
                }

                estadoVictoria = victoria(tablero, turnoAnim);

                if (estadoVictoria == 1) {
                    FinalizarPartida(turnoAnim);
                } else if (estadoVictoria == 2) {
                    FinalizarPartida(0);
                } else {
                    calcularTurno(&turno);
                }

            } else if (estadoFichas == 2) {

                MostrarMensaje("La columna esta llena!", true);
            }
        }
    }

    /* --- Dibujo del tablero --- */
    DrawRectangleRounded((Rectangle){ TABLERO_X, TABLERO_Y, TABLERO_ANCHO, TABLERO_ALTO }, 0.03f, 8, COLOR_TABLERO);

    for (int i = 0; i < FILAS; i++) {
        for (int j = 0; j < COLUMNAS; j++) {

            int cx = TABLERO_X + j * TAM_CELDA + TAM_CELDA / 2;
            int cy = TABLERO_Y + i * TAM_CELDA + TAM_CELDA / 2;
            int radio = TAM_CELDA / 2 - 8;

            Color color = COLOR_FONDO;
            if (tablero[i][j] == 1) color = COLOR_J1;
            else if (tablero[i][j] == 2) color = COLOR_J2;

            DrawCircle(cx, cy, (float)radio, color);
        }
    }

    /* --- Cantidad de movimientos de cada jugador (mov1 / mov2) --- */
    char movTexto[32];

    DrawText("Jugador 1", 20, TABLERO_Y, 18, COLOR_J1);
    snprintf(movTexto, sizeof(movTexto), "Movimientos: %d", mov1);
    DrawText(movTexto, 20, TABLERO_Y + 24, 16, DARKGRAY);

    snprintf(movTexto, sizeof(movTexto), "Movimientos: %d", mov2);
    DrawText("Jugador 2", ANCHO_VENTANA - 20 - MeasureText("Jugador 2", 18), TABLERO_Y, 18, (Color){ 200, 160, 20, 255 });
    DrawText(movTexto, ANCHO_VENTANA - 20 - MeasureText(movTexto, 16), TABLERO_Y + 24, 16, DARKGRAY);

    if (animando) {
        int cx = TABLERO_X + columnaAnim * TAM_CELDA + TAM_CELDA / 2;
        DrawCircle(cx, (int)yFichaAnim + TAM_CELDA / 2, TAM_CELDA / 2 - 8,
                   turnoAnim == 1 ? COLOR_J1 : COLOR_J2);
    }

    Rectangle btnAbandonar = { ANCHO_VENTANA / 2 - 110, TABLERO_Y + TABLERO_ALTO + 20, 220, 45 };
    if (!animando && Boton(btnAbandonar, "Abandonar partida")) {
        FinalizarPartida(3 - turno);
    }

    DibujarMensaje(TABLERO_X, TABLERO_Y + TABLERO_ALTO + 75);
}

/* ---------------------------------------------------------------------------
 * Pantalla: Fin de partida y estadisticas
 * ------------------------------------------------------------------------- */

static void PantallaFin(void) {

    char resultadoTexto[80];
    Color colorResultado;

    if (ganador == 0) {
        snprintf(resultadoTexto, sizeof(resultadoTexto), "Empate!");
        colorResultado = GRAY;
    } else {
        int idx = ubicacion[ganador - 1];
        snprintf(resultadoTexto, sizeof(resultadoTexto), "Gano %s!", jugadores[idx].Player);
        colorResultado = ganador == 1 ? COLOR_J1 : (Color){ 200, 160, 20, 255 };
    }

    DrawText(resultadoTexto, (ANCHO_VENTANA - MeasureText(resultadoTexto, 40)) / 2, 90, 40, colorResultado);

    DrawText("Estadisticas", (ANCHO_VENTANA - MeasureText("Estadisticas", 22)) / 2, 170, 22, DARKGRAY);

    int filaY = 220;
    DrawText("Jugador", ANCHO_VENTANA / 2 - 260, filaY, 18, DARKGRAY);
    DrawText("Victorias", ANCHO_VENTANA / 2 - 60, filaY, 18, DARKGRAY);
    DrawText("Racha", ANCHO_VENTANA / 2 + 60, filaY, 18, DARKGRAY);
    DrawText("Partidas", ANCHO_VENTANA / 2 + 160, filaY, 18, DARKGRAY);

    for (int i = 0; i < 2; i++) {

        PLAYERS *jugador = &jugadores[ubicacion[i]];
        int y = filaY + 35 + i * 32;

        DrawText(jugador->Player, ANCHO_VENTANA / 2 - 260, y, 18, BLACK);

        char buf[16];
        snprintf(buf, sizeof(buf), "%d", jugador->Victory);
        DrawText(buf, ANCHO_VENTANA / 2 - 60, y, 18, BLACK);

        snprintf(buf, sizeof(buf), "%d", jugador->Streak);
        DrawText(buf, ANCHO_VENTANA / 2 + 60, y, 18, BLACK);

        snprintf(buf, sizeof(buf), "%d", jugador->PMatches);
        DrawText(buf, ANCHO_VENTANA / 2 + 160, y, 18, BLACK);
    }

    Rectangle btnRevancha = { ANCHO_VENTANA / 2 - 220, 420, 200, 50 };
    Rectangle btnMenu     = { ANCHO_VENTANA / 2 + 20, 420, 200, 50 };

    if (Boton(btnRevancha, "Revancha")) {
        IniciarPartida();
    }

    if (Boton(btnMenu, "Volver al menu")) {
        IrAMenu();
    }
}

/* ---------------------------------------------------------------------------
 * 5. MAIN
 * ------------------------------------------------------------------------- */

int main(void) {

    InitWindow(ANCHO_VENTANA, ALTO_VENTANA, "4 en Raya - Raylib (Grupo Eleven)");
    SetTargetFPS(240);

    cantJugadores = CargarJugadores(jugadores, MAX_JUGADORES);

    campoUsuario.bounds     = (Rectangle){ 0, 0, 300, 40 };
    campoPassword.bounds    = (Rectangle){ 0, 0, 300, 40 };
    campoPassword.esPassword = true;
    ResetCampo(&campoUsuario);
    ResetCampo(&campoPassword);

    while (!WindowShouldClose() && !salirJuego) {

        BeginDrawing();
        ClearBackground(COLOR_FONDO);

        switch (pantalla) {
            case PANTALLA_MENU:      PantallaMenu();        break;
            case PANTALLA_REGISTRO:  PantallaRegistro();    break;
            case PANTALLA_LOGIN_J1:  PantallaLogin(1);      break;
            case PANTALLA_LOGIN_J2:  PantallaLogin(2);      break;
            case PANTALLA_JUEGO:     PantallaJuego();       break;
            case PANTALLA_FIN:       PantallaFin();         break;
        }

        EndDrawing();
    }

    CloseWindow();
    return 0;
