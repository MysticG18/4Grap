    DibujarCampoTexto(&campoUsuario, "Usuario (hasta 10 caracteres)");
    DibujarCampoTexto(&campoPassword, "Contrasena (hasta 10 caracteres)");

    Rectangle btnRegistrar = { ANCHO_VENTANA / 2 - 150, 365, 300, 50 };
    Rectangle btnVolver    = { ANCHO_VENTANA / 2 - 150, 430, 300, 45 };

    bool enviar = Boton(btnRegistrar, "Registrar") || IsKeyPressed(KEY_ENTER);

    if (enviar) {
        ResultadoRegistro resultado = RegistrarJugador(jugadores, &cantJugadores, MAX_JUGADORES,
                                                        campoUsuario.texto, campoPassword.texto);
        if (resultado == REG_OK) {
            char confirmacion[96];
            snprintf(confirmacion, sizeof(confirmacion), "Listo! ID asignada: %d. Ya podes iniciar sesion.",
                      jugadores[cantJugadores - 1].idplayer);
            MostrarMensaje(confirmacion, false);
            ResetCampo(&campoUsuario);
            ResetCampo(&campoPassword);
            campoUsuario.activo = true;
        } else {
            MostrarMensaje(MensajeRegistro(resultado), true);
        }
    }

    if (Boton(btnVolver, "Volver al menu")) {
        IrAMenu();
    }

    DibujarMensaje(ANCHO_VENTANA / 2 - 150, 500);
}

