 * 2. MODULO JUGADORES
 *
 * Persistencia: el archivo guarda primero un int con la cantidad de
 * jugadores y despues el arreglo de structs tal cual (binario). Es un
 * formato simple, suficiente para este proyecto.
 * ------------------------------------------------------------------------- */

/* Carga los jugadores guardados en ARCHIVO_JUGADORES. Devuelve la cantidad
 * de jugadores cargados (0 si el archivo no existe todavia). */
int CargarJugadores(PLAYERS players[], int maxJugadores) {

    FILE *archivo = fopen(ARCHIVO_JUGADORES, "rb");
    int cantJugadores = 0;

    if (archivo == NULL) {
        return 0; /* primera vez que se ejecuta el juego: todavia no hay archivo */
    }

    fread(&cantJugadores, sizeof(int), 1, archivo);

    if (cantJugadores < 0) cantJugadores = 0;
    if (cantJugadores > maxJugadores) cantJugadores = maxJugadores;

    fread(players, sizeof(PLAYERS), cantJugadores, archivo);

    fclose(archivo);
    return cantJugadores;
}

/* Guarda el arreglo completo de jugadores en ARCHIVO_JUGADORES. */
void GuardarJugadores(const PLAYERS players[], int cantJugadores) {

    FILE *archivo = fopen(ARCHIVO_JUGADORES, "wb");

    if (archivo == NULL) {
        return; /* si no se pudo abrir el archivo simplemente no persiste;
                    el juego sigue funcionando en memoria durante esta ejecucion */
    }

    fwrite(&cantJugadores, sizeof(int), 1, archivo);
    fwrite(players, sizeof(PLAYERS), cantJugadores, archivo);

    fclose(archivo);
}

/* ---------- Validaciones ---------- */

/* 0 = valido, 1 = vacio, 2 = demasiado largo.
 * En el original la comparacion era strlen == 1 (vacio) y strlen > 11
 * (largo) porque el texto de fgets traia el '\n'. Aca el texto de la
 * interfaz grafica no trae '\n', asi que vacio es strlen == 0 y largo es
 * strlen > 10. */
int validarString(char *InputStr) {
    int valido;
    if (strlen(InputStr) == 0) {
        valido = 1;
    } else if (strlen(InputStr) > 10) {
        valido = 2;
    } else {
        valido = 0;
    }
    return valido;
}

/* Busca inputstr entre los jugadores. Si lo encuentra deja *validar1 = 1 y
 * el indice en *ub; si no, *validar1 = 0. */
void validarUser(char *inputstr, PLAYERS players[], int cantPlayers, int *validar1, int *ub) {
    int i;
    for (i = 0; i < cantPlayers; i++) {

        if (strcmp(inputstr, players[i].Player) == 0) {

            *validar1 = 1;
            *ub = i;
            i = cantPlayers;

        } else {

            *validar1 = 0;

        }
    }
}

/* Genera un ID de 3 digitos (100-999) que todavia no este en uso, igual
 * que exigia validarID en el original. Con MAX_JUGADORES = 900 siempre
 * hay uno libre. */
static int GenerarIDUnico(const PLAYERS players[], int cantJugadores) {

    for (int candidato = 100; candidato <= 999; candidato++) {

        int enUso = 0;

        for (int i = 0; i < cantJugadores; i++) {
            if (players[i].idplayer == candidato) {
                enUso = 1;
                break;
            }
        }

        if (!enUso) {
            return candidato;
        }
    }

    return -1; /* no deberia pasar nunca si cantJugadores < 900 */
}

/* Da de alta un nuevo jugador: valida usuario/contrasena (no vacios, hasta
 * 10 caracteres, usuario no repetido -- mismas reglas que validarString /
 * validarUser del original) y le asigna un ID de 3 digitos unico
 * (equivalente a validarID). Si todo es correcto, lo agrega al arreglo,
 * incrementa *cantJugadores y guarda el archivo. */
ResultadoRegistro RegistrarJugador(PLAYERS players[], int *cantJugadores,
                                    int maxJugadores, char *nombre,
                                    char *password) {

    if (*cantJugadores >= maxJugadores) {
        return REG_LIMITE_JUGADORES;
    }

    int validacionNombre = validarString(nombre);
    if (validacionNombre == 1) return REG_USUARIO_VACIO;
    if (validacionNombre == 2) return REG_USUARIO_LARGO;

    int validar = 0;
    int ub;
    validarUser(nombre, players, *cantJugadores, &validar, &ub);
    if (validar == 1) {
        return REG_USUARIO_EXISTE;
    }

    int validacionPassword = validarString(password);
    if (validacionPassword == 1) return REG_PASSWORD_VACIA;
    if (validacionPassword == 2) return REG_PASSWORD_LARGA;

    int nuevoID = GenerarIDUnico(players, *cantJugadores);

    PLAYERS nuevo;
    nuevo.idplayer = nuevoID;
    strcpy(nuevo.Player, nombre);
    strcpy(nuevo.Password, password);
    nuevo.Streak    = 0;
    nuevo.Victory   = 0;
    nuevo.PMatches  = 0;
    nuevo.GameCount = 0;

    players[*cantJugadores] = nuevo;
    (*cantJugadores)++;

    GuardarJugadores(players, *cantJugadores);

    return REG_OK;
}

/* Valida usuario + contrasena para iniciar una partida. Si es correcto
 * devuelve LOGIN_OK y deja el indice del jugador en *ubicacion. */
ResultadoLogin ValidarLogin(char *nombre, char *password,
                            PLAYERS players[], int cantJugadores,
                            int *ubicacion) {

    int validar = 0;
    int ub = -1;

    validarUser(nombre, players, cantJugadores, &validar, &ub);

    if (validar == 0) {
        return LOGIN_USUARIO_NO_EXISTE;
    }

    if (strcmp(password, players[ub].Password) != 0) {
        return LOGIN_PASSWORD_INCORRECTA;
    }

    *ubicacion = ub;
    return LOGIN_OK;
}

/* Texto en espanol para mostrar en pantalla segun el resultado. */
