static void ResetCampo(CampoTexto *campo) {
    campo->texto[0] = '\0';
    campo->longitud = 0;
}

static void ActualizarCampoTexto(CampoTexto *campo) {

    if (!campo->activo) return;

    int tecla = GetCharPressed();
    while (tecla > 0) {
        if (tecla >= 32 && tecla <= 125 && campo->longitud < MAX_NOMBRE - 1) {
            campo->texto[campo->longitud] = (char)tecla;
            campo->longitud++;
            campo->texto[campo->longitud] = '\0';
        }
        tecla = GetCharPressed();
    }

    if (IsKeyPressed(KEY_BACKSPACE) && campo->longitud > 0) {
        campo->longitud--;
        campo->texto[campo->longitud] = '\0';
    }
}

static void DibujarCampoTexto(CampoTexto *campo, const char *etiqueta) {

    DrawText(etiqueta, (int)campo->bounds.x, (int)campo->bounds.y - 24, 18, DARKGRAY);

    Color colorBorde = campo->activo ? (Color){ 40, 120, 200, 255 } : GRAY;
    DrawRectangleRec(campo->bounds, RAYWHITE);
    DrawRectangleLinesEx(campo->bounds, 2, colorBorde);

    char textoVisible[MAX_NOMBRE];
    if (campo->esPassword) {
        int i = 0;
        for (; i < campo->longitud; i++) textoVisible[i] = '*';
        textoVisible[i] = '\0';
    } else {
        strcpy(textoVisible, campo->texto);
    }

    DrawText(textoVisible, (int)campo->bounds.x + 10, (int)campo->bounds.y + 10, 20, BLACK);

    if (campo->activo && ((int)(GetTime() * 2) % 2 == 0)) {
        int anchoTexto = MeasureText(textoVisible, 20);
        DrawText("|", (int)campo->bounds.x + 12 + anchoTexto, (int)campo->bounds.y + 10, 20, BLACK);
    }
}

static void ManejarClickCampo(CampoTexto *campoA, CampoTexto *campoB) {
    if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
        campoA->activo = CheckCollisionPointRec(GetMousePosition(), campoA->bounds);
        campoB->activo = CheckCollisionPointRec(GetMousePosition(), campoB->bounds);
    }
    if (IsKeyPressed(KEY_TAB)) {
        bool actA = campoA->activo;
        campoA->activo = !actA;
        campoB->activo = actA;
    }
}

static bool Boton(Rectangle bounds, const char *texto) {

    Vector2 mouse = GetMousePosition();
    bool sobreBoton = CheckCollisionPointRec(mouse, bounds);

    Color colorFondo = sobreBoton ? (Color){ 50, 130, 210, 255 } : (Color){ 30, 100, 180, 255 };
    DrawRectangleRounded(bounds, 0.25f, 8, colorFondo);

    int anchoTexto = MeasureText(texto, 20);
    DrawText(texto,
             (int)(bounds.x + (bounds.width - anchoTexto) / 2),
             (int)(bounds.y + (bounds.height - 20) / 2),
             20, RAYWHITE);

    return sobreBoton && IsMouseButtonPressed(MOUSE_BUTTON_LEFT);
}

static void MostrarMensaje(const char *texto, bool esError) {
    strncpy(mensaje, texto, sizeof(mensaje) - 1);
    mensaje[sizeof(mensaje) - 1] = '\0';
    mensajeEsError = esError;
}

static void DibujarMensaje(int x, int y) {
    if (mensaje[0] != '\0') {
        DrawText(mensaje, x, y, 18, mensajeEsError ? MAROON : (Color){ 20, 130, 60, 255 });
    }
}

