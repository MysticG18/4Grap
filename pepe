// 8. VERIFICAR GANADOR RECTO (Horizontal y Vertical)
int verificar_ganador_recto(char T[N][M], char ficha) {
    int i = 0;
    int j = 0;
    int b = 0;

    // busq horizpontal
    while (i < N && b == 0) {
        j = 0;
        while (j < M - 3 && b == 0) {
            if (T[i][j] == ficha && T[i][j+1] == ficha && T[i][j+2] == ficha && T[i][j+3] == ficha) {
                b = 1;
            } else {
                j = j + 1;
            }
        }
        i = i + 1;
    }

    // buusq vertical
    i = 0;
    while (i < N - 3 && b == 0) {
        j = 0;
        while (j < M && b == 0) {
            if (T[i][j] == ficha && T[i+1][j] == ficha && T[i+2][j] == ficha && T[i+3][j] == ficha) {
                b = 1;
            } else {
                j = j + 1;
            }
        }
        i = i + 1;
    }

    return b;
}

// 9. VERIFICAR GANADOR DIAGONAL
int verificar_ganador_diagonal(char T[N][M], char ficha) {
    int i = 0;
    int j = 0;
    int b = 0;

    //  BUSQUEDA DIAGONAL \ asi
    while (i < N - 3 && b == 0) {
        j = 0;
        while (j < M - 3 && b == 0) {
            if (T[i][j] == ficha && T[i+1][j+1] == ficha && T[i+2][j+2] == ficha && T[i+3][j+3] == ficha) {
                b = 1;
            } else {
                j = j + 1;
            }
        }
        i = i + 1;
    }

    // BUSQUEDA DIAGONAL / asi
    i = 3;
    while (i < N && b == 0) {
        j = 0;
        while (j < M - 3 && b == 0) {
            if (T[i][j] == ficha && T[i-1][j+1] == ficha && T[i-2][j+2] == ficha && T[i-3][j+3] == ficha) {
                b = 1;
            } else {
                j = j + 1;
            }
        }
        i = i + 1;
    }

    return b;
}

// 10. VERIFICAR GANADOR PRINCIPAL (Agrupa las busquedas para mantener limpio el main)
int verificar_ganador(char T[N][M], char ficha) {
    int b = 0;

    // 1ro: Busca victoria en lineas rectas (horizontal y vertical)
    b = verificar_ganador_recto(T, ficha);

    // 2do: Si no gano en recta (b == 0), busca en lineas diagonales
    if (b == 0) {
        b = verificar_ganador_diagonal(T, ficha);
    }

    return b;
}

// 11. GUARDAR DATOS DE PARTIDA Y ESTADISTICAS
// resultados: 0=empate, 1=victoria del turno actual, 2= descalificacion, pierde el turno actual
void guardar_datos_partida(TJugador jug[], TPartida part[], int *tot_part, int id1, int id2, int resultado, int turno_actual, int turnos_jugados) {
    int pos = *tot_part;
    int movimientos1 = -1;
    int movimientos2 = -1;
    int ganador1 = -1;
    int perdedor1 = -1;

    // sumar a las partidas jugadas
    jug[id1].partidasJugadas = jug[id1].partidasJugadas + 1;
    jug[id2].partidasJugadas = jug[id2].partidasJugadas + 1;

    // movimientos q hizo cada uno
    movimientos1 = (turnos_jugados + 1) / 2;
    movimientos2 = turnos_jugados / 2;

    // estructura de la partida
    part[pos].idJugador1 = id1;
    part[pos].idJugador2 = id2;
    part[pos].movJugador1 = movimientos1;
    part[pos].movJugador2 = movimientos2;
    part[pos].turnos = turnos_jugados;

    if (resultado == 0) {
        part[pos].motivoFin= 'E';
        part[pos].idGanador = -1;
        jug[id1].rachaGanadora = 0;
        jug[id2].rachaGanadora = 0;
    }else{
      if (resultado == 1) {
        part[pos].motivoFin = 'V'; // Victoria

        if (turno_actual == 1) {
            part[pos].idGanador = id1;
            jug[id1].partidasGanadas = jug[id1].partidasGanadas + 1;
            jug[id1].rachaGanadora = jug[id1].rachaGanadora + 1;
            jug[id2].rachaGanadora = 0;
        } else {
            part[pos].idGanador = id2;
            jug[id2].partidasGanadas = jug[id2].partidasGanadas + 1;
            jug[id2].rachaGanadora = jug[id2].rachaGanadora + 1;
            jug[id1].rachaGanadora = 0;
        }
    }else {
        part[pos].motivoFin = 'D';
        if (turno_actual == 1) {
            part[pos].idGanador = id2;
            jug[id2].partidasGanadas = jug[id2].partidasGanadas + 1;
            jug[id2].rachaGanadora = jug[id2].rachaGanadora + 1;
        }else {
            part[pos].idGanador = id1;
            jug[id1].partidasGanadas = jug[id1].partidasGanadas + 1;
            jug[id1].rachaGanadora = jug[id1].rachaGanadora + 1;
        }
    }
    }
    jug[id1].porcentaje = ((float)jug[id1].partidasGanadas / jug[id1].partidasJugadas) * 100.0;
    jug[id2].porcentaje = ((float)jug[id2].partidasGanadas / jug[id2].partidasJugadas) * 100.0;

    *tot_part = *tot_part + 1; 
}

