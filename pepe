// 1. INICIALIZAR TABLERO
void tablero_inicial(char T[N][M]) {
    int i = 0, j = 0;

    // Inicializamos todas las casillas con el guion '-'
    for (i = 0; i < N; i++) {
        for (j = 0; j < M; j++) {
            T[i][j] = '-';
        }
    }
}

// 2. IMPRIMIR TABLERO
void imprimir_tablero(char T[N][M]) {
