}

// 3. VERIFICAR CASILLA
int casilla_ocupada(char T[N][M], int i, int j) {
    int b = 0;
    if (T[i][j] == '-') {
        b = 0;
    } else {
        b = 1;
    }
    return b;
}

// 4. SIMULAR GRAVEDAD
int soltar_ficha(char T[N][M], int c, char ficha_actual) {
    int j = c - 1;
    int i = N - 1;
    int b = 0;

    // Recorre de abajo hacia arriba mientras la bandera sea 0
    while (i >= 0 && b == 0) {
        if (casilla_ocupada(T, i, j) == 0) {
            T[i][j] = ficha_actual; // Asignamos la ficha que nos paso el main directo
            b = 1;                  // Ficha puesta, corta la busqueda
        } else {
            i = i - 1; // Sube una fila si esta ocupada
        }
    }

    if (b == 0) {
        printf("La columna esta llena. FALTA!\n");
    }
    return b;
}

// 5. PEDIR Y VERIFICAR TURNO (devuelve 1 si la jugad fue valida y 0 si fue falta (ya sea por fuera de rango o columna incorrecta))
int verificar_ficha(char T[N][M], char ficha_actual) {
    int c = 0;
    int valida=0;

    printf("\nIngrese una columna (1-7): ");
        scanf("%d", &c);
        if (c < 1 || c > 7) {
            printf("Columna fuera de rango. FALTA!\n");
        }else {
            valida  = soltar_ficha(T, c, ficha_actual);
        }
        return valida;
}

