    } else {
        printf("\nEl tablero esta lleno. La partida termina en EMPATE!\n");
    }
}

//20 EMPEZAR Y JUGAR PARTIDA lol
void jugar_partida(TJugador lista[], int id1, int id2, int *fin_juego, int *turno_actual, int *turnos_jugados) {
    char T[N][M];
    int faltas1 = 0;
    int faltas2 = 0;

    *fin_juego = 0;
    *turno_actual = 1;
    *turnos_jugados = 0;

    printf("\n EMPIEZA EL JUEGOOO!\n");
    tablero_inicial(T);
    imprimir_tablero(T);
    while (*fin_juego == 0 && *turnos_jugados < N * M) {
        if (*turno_actual == 1) {
            *fin_juego = jugar_turno(T, 'A', lista[id1].usuario, &faltas1, turnos_jugados);
        }
         else {
            *fin_juego = jugar_turno(T, 'R', lista[id2].usuario, &faltas2, turnos_jugados);
        }
        if (*fin_juego == 0) {
            if (*turno_actual == 1) {
                *turno_actual=2;
            }else {
                *turno_actual=1;
            }
        }
    }

    mostrar_resultado(*fin_juego, *turno_actual, lista[id1].usuario, lista[id2].usuario);
}

//OPCION JUGARR
void opcion_jugar(TJugador lista[], int *id1, int *id2, TPartida partidas[], int *total_partidas) {
    int fin_juego = 0;
    int turno_actual = 1;
    int turnos_jugados = 0;

    if (*id1 != -1 && *id2 != -1 && *total_partidas < MAX_PARTIDAS) {
        jugar_partida(lista, *id1, *id2, &fin_juego, &turno_actual, &turnos_jugados);

        guardar_datos_partida(lista, partidas, total_partidas, *id1, *id2, fin_juego, turno_actual, turnos_jugados);
        printf("\nEstadisticas actualizadas y partida guardada en el registro!\n");
        mostrar_estadisticas(lista);
        *id1 = -1;
        *id2 = -1;
    } else {
        printf("Faltan jugadores. Tienen que iniciar sesion los dos.\n");
    }
}

//para ejecutar las opciones
void ejecutar_opcion(int opcion, TJugador lista[], int *id1, int *id2, TPartida partidas[], int *total_partidas) {
    if (opcion == OP_LOGIN) {
        opcion_iniciar_sesion(lista, id1, id2);
    } else if (opcion == OP_JUGAR) {
        opcion_jugar(lista, id1, id2, partidas, total_partidas);
    } else if (opcion == OP_ESTADISTICAS) {
        mostrar_estadisticas(lista);
    } else if (opcion == OP_SALIR) {
        printf("Saliendo del juego...\n");
    } else {
        printf("Opcion invalida, intente de nuevo.\n");
    }
}

