//16 jugar turno
// 0 = la partida sigue, 1 = este jugador gano, 2 = este jugador fue descalificado
int jugar_turno(char T[N][M], char ficha, char nombre[], int *faltas, int *turnos_jugados) {
    int estado = 0;
    printf("\nTurno de %s (Ficha %c)\n", nombre, ficha);
    if (verificar_ficha(T, ficha) == 1) {
        *faltas = 0;
        *turnos_jugados = *turnos_jugados + 1;
        imprimir_tablero(T);
        estado = verificar_ganador(T, ficha);
    }
    else {
        *faltas = *faltas + 1;
        printf("Falta %d de %d. Pierdes el turno\n", *faltas, MAX_FALTAS);
        if (*faltas == MAX_FALTAS) {
            estado = 2;
        }
    }
    return estado;
}

